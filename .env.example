# ─── 프론트엔드 (Vite) ────────────────────────────────────────
# Supabase 프로젝트 설정 (Settings → API 에서 확인)
# 미설정 시 오프라인 데모 모드로 동작합니다 (혼자만 있는 방).
VITE_SUPABASE_URL=
# 새 프로젝트는 sb_publishable_... 형식입니다.
# 예전 프로젝트의 anon JWT(eyJ...) 도 되지만, 키를 갈아엎은 프로젝트에서는
# 옛 JWT 가 "Invalid API key" 로 거부됩니다. 대시보드에 보이는 현재 값을 쓰세요.
# ⚠️ sb_secret_... / service_role 은 절대 넣지 마세요 (RLS 를 무시합니다).
VITE_SUPABASE_ANON_KEY=

# ─── 흡연실 NPC (서버 전용) ───────────────────────────────────
# 아래 값들은 여기가 아니라 .dev.vars (로컬) 또는
# Cloudflare Pages → Settings → Environment variables (배포) 에 넣습니다.
# VITE_ 접두사를 붙이면 브라우저로 노출되므로 절대 붙이지 마세요.
# 자세한 내용은 .dev.vars.example 참고.
