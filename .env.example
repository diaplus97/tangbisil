# ─── 프론트엔드 (Vite) ────────────────────────────────────────
# Supabase 프로젝트 설정 (Settings → API 에서 확인)
# 미설정 시 오프라인 데모 모드로 동작합니다 (혼자만 있는 방).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── 흡연실 NPC (서버 전용) ───────────────────────────────────
# 아래 값들은 여기가 아니라 .dev.vars (로컬) 또는
# Cloudflare Pages → Settings → Environment variables (배포) 에 넣습니다.
# VITE_ 접두사를 붙이면 브라우저로 노출되므로 절대 붙이지 마세요.
# 자세한 내용은 .dev.vars.example 참고.
