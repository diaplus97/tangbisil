# 프로덕션 빌드용 Supabase 설정 (Vite 가 빌드할 때 읽는다)
#
# 이 두 값은 레포에 커밋돼 있다. 실수가 아니다 —
# VITE_ 변수는 어차피 브라우저 번들에 그대로 박히는 공개 값이라
# 여기 있든 없든 노출 범위가 똑같다. anon key 는 원래 그런 용도의 키다.
# 실제 방어선은 Supabase 의 RLS 정책이다 (supabase/schema.sql 참고 — 삭제 차단).
#
# 왜 대시보드가 아니라 파일이냐:
# Cloudflare 는 "런타임 변수"와 "빌드 변수"가 따로고, Secret 타입은
# 빌드에 노출되지 않는다. 어느 칸에 넣었는지에 따라 조용히 오프라인으로
# 빌드되는데 에러가 안 나서 구별이 안 된다. 그 변수를 아예 없앴다.
#
# ⚠️ service_role key 는 절대 여기 넣지 말 것. RLS 를 통째로 무시한다.
# ⚠️ ANTHROPIC_API_KEY 도 절대 여기 넣지 말 것 — 서버 전용이고,
#    Cloudflare 대시보드의 런타임 Secret 으로만 둔다.

# 이 프로젝트는 Supabase 새 키 체계를 쓴다 (sb_publishable_...).
# 예전 anon JWT(eyJ...) 는 이 프로젝트에서 이미 무효라 "Invalid API key" 가 났었다.

VITE_SUPABASE_URL=https://mfxxtwcrrgoqhkcmzawn.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_zx7UkbRiankx2JVzjbReYg_k4fr_Zi7
